// AchtMart — Prisma schema
// All monetary fields are stored as Int in paise (1 INR = 100 paise) to avoid floating point error.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // No directUrl — migrations run through the Neon pooler with
  // PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 (set inline in package.json's
  // build script). directUrl pointed at the non-pooler endpoint, which
  // Neon idles aggressively, and Prisma v6's client opens a check against
  // it at startup — breaking every dashboard page when the direct compute
  // is asleep.
}

// ---------- USERS ----------

enum Role {
  CUSTOMER
  ADMIN
  PROMAX_ADMIN
}

// Member-selectable display language for product names. EN is the default and
// the fallback whenever a localized name is missing.
enum Language {
  EN
  TA
  HI
}

enum Slot {
  LEFT
  RIGHT
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id           String   @id @default(cuid())
  email        String
  phone        String?
  // Distinct WhatsApp contact number — captured at loan apply time and used
  // by the admin's WhatsApp reach-out button for repayment reminders. Falls
  // back to `phone` when null. Optional everywhere except the loan flow.
  whatsappNumber String?
  name         String
  passwordHash String
  transactionPasswordHash String?  // separate password required for sensitive ops (pin transfer)
  mustChangeTransactionPassword Boolean @default(false) // true when admin has reset txn pw to the user's mobile and is awaiting the member to choose a new one
  mustChangePassword Boolean  @default(false) // true when account was created with a default password (mobile)
  mustOnboard        Boolean  @default(false) // true for fresher accounts — forced through the Add Member form on first login
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  // Member's preferred display language for product names in the shop & orders
  // (English default). See lib/i18n.ts; admin UI always stays English.
  preferredLanguage Language @default(EN)
  // When false (default), the display language is auto-derived from the member's
  // delivery-address state (Tamil Nadu→Tamil, Hindi-belt→Hindi, else English).
  // Set true once the member picks a language by hand — then preferredLanguage wins.
  languageIsManual  Boolean  @default(false)
  // Admin override: when true, the member can use the 1000-pt Pin Wallet even
  // if they don't meet the both-legs-filled requirement. See lib/pin-wallet-access.
  pinWalletUnlocked Boolean @default(false)
  // Admin kill-switch: when true, the Pin Wallet is force-locked regardless of
  // legs or the unlock override — used to freeze a member if there's an issue.
  pinWalletLocked   Boolean @default(false)

  referralCode String   @unique
  referrerId   String?
  referrer     User?    @relation("Referrals", fields: [referrerId], references: [id])
  referrals    User[]   @relation("Referrals")

  // Binary placement
  slot              Slot?    // L or R under referrer; null for root or legacy
  pairBonusAwarded  Boolean  @default(false) // tracks one-time +5 first-pair bonus
  leftLegCount      Int      @default(0)     // descendants in LEFT leg (cached for points engine)
  rightLegCount     Int      @default(0)     // descendants in RIGHT leg (cached for points engine)
  gatedPointsEarned Int      @default(0)     // running total of gated +1 credits, used to compute deltas

  // ---- Pin Pro Max — a fully PARALLEL binary program (10,000-pt pin). These
  // fields mirror the 1000-pt placement above but form an entirely separate
  // tree (see src/lib/points-promax.ts / network-promax.ts). The 1000-pt
  // engine never reads or writes them, and vice-versa.
  isProMax               Boolean @default(false) // member is part of the Pro Max program
  proMaxReferrerId       String?                 // placement parent in the Pro Max tree
  proMaxReferrer         User?   @relation("ProMaxReferrals", fields: [proMaxReferrerId], references: [id])
  proMaxReferrals        User[]  @relation("ProMaxReferrals")
  proMaxSlot             Slot?                   // L or R under proMaxReferrer
  proMaxPairBonusAwarded Boolean @default(false) // one-time +5,000 first-pair bonus
  proMaxLeftLegCount     Int     @default(0)     // descendants in Pro Max LEFT leg
  proMaxRightLegCount    Int     @default(0)     // descendants in Pro Max RIGHT leg

  // Registration profile (captured at signup; some are admin-edit-only)
  nominee           String?
  gender            Gender?
  address           String?
  panNumber         String?  // NOT unique: one PAN may be used up to 15 times
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?

  agreedToTermsAt DateTime?

  addresses     Address[]
  kyc           KycDetail?
  wallet        Wallet?
  orders        Order[]
  commissions   Commission[]   @relation("CommissionBeneficiary")
  payoutRequests PayoutRequest[]

  ordersAsL1Ref Order[] @relation("OrderL1Ref")
  ordersAsL2Ref Order[] @relation("OrderL2Ref")

  // Pin system
  pinRequests   PinRequest[]
  pinPurchases  PinPurchase[]
  pinWalletTxns PinWalletTxn[]
  pinsOwned     Pin[]          @relation("PinOwner")
  pinUsedToJoin Pin?           @relation("PinUsedFor")

  // ---- Franchise. A franchise leader is an ordinary member the admin has
  // promoted. Their downline's loan requests and Welcome Kit claims route to
  // them first for vetting, then on to the admin. Ownership is by nearest
  // franchise ancestor in the referral chain (see lib/franchise.ts).
  isFranchise        Boolean   @default(false)
  franchiseGrantedAt DateTime?
  franchiseRequests  FranchiseRequest[]
  // Rows this member vetted in their capacity as a franchise leader.
  franchiseLoans        Loan[]        @relation("FranchiseLoans")
  franchiseRewardClaims RewardClaim[] @relation("FranchiseRewardClaims")
  // ---- Franchise Welcome Kit stock. The admin ships physical Welcome Kits to a
  // franchise leader; `franchiseStockReceived` is the running total ever sent
  // (never decreases) and `franchiseStockCurrent` is what's left on their shelf
  // — it drops by one each time they mark a Welcome Kit delivered. Both are
  // backed by the append-only FranchiseStockTxn ledger.
  franchiseStockReceived Int @default(0)
  franchiseStockCurrent  Int @default(0)
  franchiseStockTxns     FranchiseStockTxn[]

  // Loans
  loans         Loan[]
  // Admin override: when true, the loan identity/PAN-reuse guards are bypassed
  // for this member (granted after an admin approves their unlock request).
  loanUnlocked  Boolean @default(false)
  loanUnlockRequests LoanUnlockRequest[]

  // Nightly 10% payouts (90% paid, 10% forfeit, balance resets to 0)
  dailyPayouts  DailyPayout[]

  // Reward claims
  rewardClaims  RewardClaim[]

  // Pro Max rewards (combo box requests + admin-granted level rewards)
  proMaxRewards ProMaxReward[]

  // In-app notifications (e.g. admin credited the pin wallet)
  notifications Notification[]

  // Transaction-password reset requests (member asks admin to reset)
  txnPwResetRequests TxnPasswordResetRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId])
  @@index([isFranchise])
  @@index([referrerId, slot])
  @@index([proMaxReferrerId, proMaxSlot])
  @@index([panNumber])
  @@index([email])
  @@index([phone])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model KycDetail {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  panNumber          String?
  panName            String?
  bankAccount        String?
  ifsc               String?
  bankHolderName     String?
  productReceiptUrl  String?   @db.Text
  status             KycStatus @default(NOT_SUBMITTED)
  reviewerNotes      String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  updatedAt          DateTime  @updatedAt
}

model Wallet {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balancePending      Int      @default(0) // commission accrued, in 30-day cooling-off window (paise)
  balanceAvailable    Int      @default(0) // eligible for payout (paise)
  balancePaidLifetime Int      @default(0) // total paid out historically (paise)
  pinWalletBalance    Int      @default(0) // points usable only to buy pins (paise); funded by the Rs.2,000 loan or a payout transfer
  // ---- Pin Pro Max wallet — earnings from the separate Pro Max tree. Paid out
  // by the same nightly 90/10 cycle as balanceAvailable, but tracked apart.
  proMaxBalanceAvailable    Int @default(0) // Pro Max points eligible for payout (paise)
  proMaxBalancePaidLifetime Int @default(0) // total Pro Max paid out historically (paise)
  updatedAt           DateTime @updatedAt
}

// Ledger of every credit/debit to a user's Pin Wallet. Append-only audit trail
// behind pinWalletBalance — admin and the user can see exactly where points came
// from and went.
enum PinWalletTxnType {
  LOAN_CREDIT       // Rs.2,000 (DIRECTS_1_1) loan disbursed into the pin wallet
  PAYOUT_TRANSFER   // member moved points in from their payout (e-wallet) balance
  PIN_PURCHASE      // points spent buying pins (debit)
  ADMIN_CREDIT      // admin manually added points to the member's pin wallet
  LOAN_REPAYMENT    // points spent repaying a loan installment (debit; +9% + any penalty)
}

model PinWalletTxn {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         PinWalletTxnType
  amount       Int              // signed paise: positive = credit, negative = debit
  balanceAfter Int              // pinWalletBalance immediately after this txn (paise)
  note         String?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
}

// ---------- CATALOG ----------

// Top-level catalog split. WELLNESS is the original Ayurvedic/wellness range;
// GROCERIES is the Tamil grocery/podi/mix range (grouped further by subCategory).
enum ProductCategory {
  WELLNESS
  GROCERIES
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String   // English name (default display + admin/order snapshot)
  // Optional localized names shown to members per their preferredLanguage.
  // Null falls back to the English `name`. See lib/i18n.ts.
  nameTa       String?  // Tamil
  nameHi       String?  // Hindi (Devanagari)
  category     ProductCategory @default(WELLNESS)
  subCategory  String?  // grocery group label (e.g. "Masala Powders"); null for wellness
  shortDesc    String
  description  String   @db.Text
  ingredients  String?  @db.Text
  mrp          Int      // MRP in paise (e.g., Rs 1299 = 129900)
  price        Int      // selling price in paise
  stock        Int      @default(0)
  sku          String   @unique
  imageUrl     String
  gallery      String[] @default([])
  gstRate      Int      @default(18) // GST percent (12 for some ayurvedic, 18 for most wellness)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// ---------- ORDERS ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

// How the member paid for the order.
//   COD           — Cash on Delivery, paid when the parcel arrives.
//   WALLET_POINTS — paid up-front by debiting the payout wallet (balanceAvailable).
enum PaymentMethod {
  COD
  WALLET_POINTS
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])

  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod  PaymentMethod @default(COD)

  subtotal       Int // sum of (item price * qty) in paise, exclusive of GST
  gstAmount      Int // total GST in paise
  shippingCost   Int @default(0)
  discount       Int @default(0)
  totalAmount    Int // grand total in paise

  razorpayOrderId    String? @unique
  razorpayPaymentId  String?
  razorpaySignature  String?

  // shipping address snapshot
  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String

  trackingNumber String?
  courier        String?

  // referral attribution snapshot at order time
  l1ReferrerId String?
  l1Referrer   User?   @relation("OrderL1Ref", fields: [l1ReferrerId], references: [id])
  l2ReferrerId String?
  l2Referrer   User?   @relation("OrderL2Ref", fields: [l2ReferrerId], references: [id])

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  returnedAt  DateTime?

  // 2021 Direct Selling Rules: buyback window
  buybackUntil DateTime?

  items       OrderItem[]
  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([l1ReferrerId])
  @@index([l2ReferrerId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String // snapshot
  sku       String // snapshot
  unitPrice Int    // snapshot, in paise
  quantity  Int
  gstRate   Int    // snapshot
  lineTotal Int    // unitPrice * quantity (pre-GST), in paise
  gstTotal  Int    // GST on lineTotal, in paise

  @@index([orderId])
}

// ---------- AFFILIATE / COMMISSIONS ----------

enum CommissionStatus {
  PENDING    // accrued, still in 30-day cooling window
  AVAILABLE  // eligible for payout
  REQUESTED  // attached to a payout request
  PAID
  REVERSED   // order was returned/refunded
}

model Commission {
  id              String           @id @default(cuid())
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beneficiaryId   String
  beneficiary     User             @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id])
  level           Int              // 1 or 2
  ratePercent     Int              // rate at time of accrual (e.g., 20 or 5)
  baseAmount      Int              // base on which commission was calculated (paise) — uses pre-GST subtotal
  commissionAmount Int             // gross commission in paise
  status          CommissionStatus @default(PENDING)
  availableAt     DateTime?        // when status flips to AVAILABLE
  payoutRequestId String?
  payoutRequest   PayoutRequest?   @relation(fields: [payoutRequestId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([beneficiaryId, status])
  @@index([orderId])
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  FAILED
}

model PayoutRequest {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  amountGross     Int          // sum of commissions requested (paise)
  tdsRate         Int          @default(0) // basis points-ish; we'll store percent*100
  tdsAmount       Int          @default(0) // TDS deducted on this payout (paise)
  amountNet       Int          // amount actually paid out (paise)
  status          PayoutStatus @default(REQUESTED)
  bankSnapshot    String?      // JSON snapshot of KYC bank details at time of request
  utr             String?      // bank reference once paid
  reviewerNotes   String?
  requestedAt     DateTime     @default(now())
  processedAt     DateTime?
  commissions     Commission[]

  @@index([userId])
  @@index([status])
}

// ---------- SETTINGS / MISC ----------

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
}

// ---------- PIN GENERATION SYSTEM ----------

enum PinStatus {
  ACTIVE   // unused, ready to use
  USED     // consumed when creating a downline member
  REVOKED  // admin revoked
}

enum PinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TxnPwResetStatus {
  PENDING
  APPROVED
  REJECTED
}

model TxnPasswordResetRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        TxnPwResetStatus @default(PENDING)
  reviewerId    String?
  reviewerNotes String?
  requestedAt   DateTime         @default(now())
  reviewedAt    DateTime?

  @@index([userId])
  @@index([status, requestedAt])
}

model PinRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity      Int
  mobileNumber  String
  // Pin denomination the member selected: 1000 (standard) or 2000. Purely a
  // value/label — it does not affect binary placement or the points engine.
  // The 2000-pt tier additionally entitles the member to a 2000-pt reward
  // (see PinReward) they can claim once per 2000-pt pin obtained.
  pointsValue   Int              @default(1000)
  proMax        Boolean          @default(false) // true = Pro Max (10,000-pt) pins
  status        PinRequestStatus @default(PENDING)
  reviewerNotes String?
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
  pins          Pin[]

  @@index([userId])
  @@index([status, createdAt])
}

model Pin {
  id            String      @id @default(cuid())
  code          String      @unique // e.g. AM12345678
  ownerId       String
  owner         User        @relation("PinOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requestId     String?
  request       PinRequest? @relation(fields: [requestId], references: [id])
  purchaseId    String?
  purchase      PinPurchase? @relation(fields: [purchaseId], references: [id])
  proMax        Boolean     @default(false) // true = Pro Max (10,000-pt) pin, used to build the Pro Max tree
  // Denomination carried over from the request/purchase (1000 or 2000). Used to
  // count how many 2000-pt pins a member obtained, which gates the PinReward.
  pointsValue   Int         @default(1000)
  status        PinStatus   @default(ACTIVE)
  usedForUserId String?     @unique
  usedForUser   User?       @relation("PinUsedFor", fields: [usedForUserId], references: [id])
  createdAt     DateTime    @default(now())
  usedAt        DateTime?

  @@index([ownerId, status])
  @@index([purchaseId])
}

// Leader (50+ downline) Razorpay self-checkout for pins. Bypasses admin review;
// pins are minted ACTIVE on payment verify. Admin sees these in a separate
// table for audit / reconciliation.
enum PinPurchaseStatus {
  PENDING  // Razorpay order created, awaiting payment confirmation
  PAID     // signature verified, pins minted
  FAILED
}

// How a pin purchase was funded. RAZORPAY = leader self-checkout (online card);
// PIN_WALLET = paid from the member's Pin Wallet points (no admin approval).
enum PinPurchaseSource {
  RAZORPAY
  PIN_WALLET
}

model PinPurchase {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity           Int
  mobileNumber       String
  pricePerPin        Int               // paise, snapshot at purchase time
  totalAmount        Int               // paise: quantity * pricePerPin
  status             PinPurchaseStatus @default(PENDING)
  source             PinPurchaseSource @default(RAZORPAY)
  razorpayOrderId    String?           @unique // null for PIN_WALLET purchases
  razorpayPaymentId  String?
  razorpaySignature  String?
  pins               Pin[]
  createdAt          DateTime          @default(now())
  paidAt             DateTime?
  updatedAt          DateTime          @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([source, paidAt])
}

// ---------- DAILY POINTS PAYOUT ----------
// Every night at 00:00 IST, each wallet with balanceAvailable > 0 gets a
// DailyPayout row created: 90% of the balance is paid out (admin disburses
// offline), 10% is forfeited, and the wallet's balanceAvailable resets to 0.
// The unique [userId, runDate] index makes the cron job idempotent.

enum DailyPayoutStatus {
  PENDING   // generated by cron, admin needs to disburse offline
  PAID      // admin disbursed and marked paid
  CANCELLED
}

model DailyPayout {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  runDate       String            // YYYY-MM-DD in Asia/Kolkata
  proMax        Boolean           @default(false) // true = payout of the Pro Max wallet (proMaxBalanceAvailable)
  startBalance  Int               // balance at the moment of the run (paise)
  paidAmount    Int               // 90% (floor)
  forfeitAmount Int               // remainder = startBalance - paidAmount
  status        DailyPayoutStatus @default(PENDING)
  reviewerNotes String?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, runDate, proMax])
  @@index([status])
  @@index([runDate])
}

// ---------- FRANCHISE ----------

enum FranchiseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A member asking the admin to be made a franchise leader. The admin can also
// promote someone directly (the "offline" path) without a request row existing.
model FranchiseRequest {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  note       String?                @db.Text // member's pitch / area they cover
  status     FranchiseRequestStatus @default(PENDING)
  adminNote  String?                @db.Text
  requestedAt DateTime              @default(now())
  reviewedAt DateTime?

  @@index([status, requestedAt])
  @@index([userId])
}

// Where a request sits in the franchise → admin approval chain. NONE means the
// member has no franchise leader above them, so the row goes straight to the
// admin queue exactly as it did before franchises existed.
enum FranchiseApproval {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum FranchiseStockTxnType {
  GRANT   // admin shipped kits to the franchise (positive)
  CONSUME // franchise delivered a Welcome Kit, one leaves stock (negative)
  ADJUST  // admin manual correction (signed)
}

// Append-only ledger behind a franchise leader's Welcome Kit stock counters.
// Every admin shipment and every delivery lands one row here, so the two
// cached totals on User can always be reconciled from history.
model FranchiseStockTxn {
  id           String                @id @default(cuid())
  franchiseId  String                // the franchise leader (User.id)
  franchise    User                  @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  type         FranchiseStockTxnType
  quantity     Int                   // signed: +granted, -consumed
  balanceAfter Int                   // franchiseStockCurrent immediately after this txn
  note         String?               @db.Text
  actorId      String?               // admin who granted/adjusted; null for auto CONSUME
  rewardClaimId String?              // the delivered Welcome Kit claim, for CONSUME rows
  createdAt    DateTime              @default(now())

  @@index([franchiseId, createdAt])
}

// ---------- LOANS ----------

enum LoanStatus {
  REQUESTED   // applied, awaiting admin review
  APPROVED    // admin verified & disbursed offline
  REJECTED
  CLOSED      // all installments verified
}

enum LoanUnlockStatus {
  PENDING
  APPROVED
  REJECTED
}

// A member blocked by the loan identity/PAN-reuse guard can ask an admin to
// unlock loans for their account. Admin reviews these in one place; approving
// sets User.loanUnlocked = true so the guards are bypassed for that member.
model LoanUnlockRequest {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String?          @db.Text
  status     LoanUnlockStatus @default(PENDING)
  adminNote  String?          @db.Text
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

enum LoanInstallmentStatus {
  PENDING            // not yet paid
  RECEIPT_UPLOADED   // user uploaded a receipt, awaiting admin verify
  VERIFIED           // admin accepted the receipt
}

model Loan {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  tierKey       String        // e.g. "DIRECTS_1_1", "LEG_7", "LEG_31"
  amount        Int           // total loan principal, paise
  totalWeeks    Int           // repayment period
  proMax        Boolean       @default(false) // true = Pro Max (10,000-pt) loan, separate ladder + admin
  status        LoanStatus    @default(REQUESTED)

  // ---- Franchise pre-approval. When the borrower sits under a franchise
  // leader, the request goes to that leader first; the admin queue only shows
  // it once franchiseStatus is APPROVED. NONE = no leader, straight to admin.
  franchiseId         String?
  franchise           User?             @relation("FranchiseLoans", fields: [franchiseId], references: [id])
  franchiseStatus     FranchiseApproval @default(NONE)
  franchiseNotes      String?           @db.Text
  franchiseReviewedAt DateTime?

  reviewerNotes String?
  requestedAt   DateTime      @default(now())
  approvedAt    DateTime?
  rejectedAt    DateTime?
  closedAt      DateTime?
  dueDate       DateTime?     // overall due date = approvedAt + totalWeeks * 7d

  installments  LoanInstallment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([franchiseId, franchiseStatus])
}

model LoanInstallment {
  id            String                @id @default(cuid())
  loanId        String
  loan          Loan                  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  weekNumber    Int                   // 1..totalWeeks
  amount        Int                   // paise
  dueDate       DateTime
  status        LoanInstallmentStatus @default(PENDING)

  receiptMime   String?
  receiptBase64 String?               @db.Text
  uploadedAt    DateTime?

  verifiedAt    DateTime?
  reviewerNotes String?

  lastReminderAt DateTime?            // admin tracking — when an unpaid-due reminder was last sent

  penaltyPaise  Int                   @default(0) // accumulated overdue penalty in paise

  // true when the member submitted payment from their Pin Wallet points (held on
  // submission, awaiting admin approval). No receipt file; admin approves/rejects
  // in the same queue. Reject refunds the points.
  paidViaWallet Boolean               @default(false)

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([loanId])
  @@index([status, dueDate])
  @@unique([loanId, weekNumber])
}

// Audit log for sensitive admin actions
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   // e.g., "PAYOUT_PROCESSED", "KYC_APPROVED", "ORDER_CANCELLED"
  target    String?  // ID of the entity affected
  metadata  String?  @db.Text // JSON blob
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// ---------- NEWS / ANNOUNCEMENTS ----------

// ---------- REWARDS ----------

enum RewardClaimStatus {
  PENDING
  APPROVED
  DISPATCHED
  DELIVERED
  REJECTED
}

model RewardClaim {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  level       Int               // 1-15
  rewardName  String
  status      RewardClaimStatus @default(PENDING)
  adminNote   String?           @db.Text
  requestedAt DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // ---- Franchise fulfilment. Only the Welcome Kit (level 0) is handled by a
  // franchise leader: they approve the claim and physically deliver it, and the
  // admin is notified rather than shipping it themselves. Every other level
  // stays on the admin's own dispatch queue (franchiseStatus NONE).
  franchiseId         String?
  franchise           User?             @relation("FranchiseRewardClaims", fields: [franchiseId], references: [id])
  franchiseStatus     FranchiseApproval @default(NONE)
  franchiseNotes      String?           @db.Text
  franchiseReviewedAt DateTime?
  franchiseDeliveredAt DateTime?

  @@unique([userId, level])
  @@index([status, requestedAt])
  @@index([franchiseId, franchiseStatus])
}

// Pro Max programme reward ladder — separate from the 1,000-pt RewardClaim.
// level 0 = Welcome Kit; levels 1-15 = the PLAN 2 prize ladder (see
// lib/rewards-promax.ts). A level unlocks when both Pro Max legs are filled to
// that depth; the member claims, the admin approves/dispatches/delivers, and
// levels 1-6 credit Pin Wallet points on approval. One claim per member+level.
model ProMaxReward {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int               // 0 = Welcome Kit, 1-15 = ladder
  rewardName  String
  status      RewardClaimStatus @default(PENDING)
  adminNote   String?           @db.Text
  requestedAt DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, level])
  @@index([status, requestedAt])
}

// ---------- NEWS ----------

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(true)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}

// Public SEO blog/articles — wellness content that pulls organic traffic and
// is the clean home for Amazon affiliate links + (optional) display ads.
model Article {
  id              String   @id @default(cuid())
  slug            String   @unique // URL: /blog/<slug>
  title           String
  excerpt         String?  @db.Text // short summary for cards + meta description
  content         String   @db.Text // body (paragraphs, ## headings, links)
  coverImageUrl   String?  // optional hero image URL
  metaDescription String?  // optional SEO override; falls back to excerpt
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// ---------- MOBILE ----------

// ---------- NOTIFICATIONS ----------

// Simple per-user in-app notification. Shown as a banner on the dashboard until
// the member dismisses it (read = true).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // Expo push token (ExponentPushToken[…])
  platform  String? // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
