# --- Database (Neon / Supabase / Railway Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/achtmart?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Razorpay (get from https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# --- Business rules (can be overridden via DB Setting table at runtime) ---
COMMISSION_L1_PERCENT=20
COMMISSION_L2_PERCENT=5
BUYBACK_DAYS=30
TDS_PERCENT=5
TDS_THRESHOLD_INR=15000
GST_DEFAULT_PERCENT=18
SHIPPING_COST_INR=0

# --- Admin bootstrap (used by seed only) ---
SEED_ADMIN_EMAIL="admin@achtmart.com"
SEED_ADMIN_PASSWORD="ChangeMe@2026"
SEED_ADMIN_NAME="ACHT MART Admin"

# --- Public ---
NEXT_PUBLIC_APP_NAME="ACHT MART"
NEXT_PUBLIC_SUPPORT_EMAIL="support@achtmart.com"
NEXT_PUBLIC_SUPPORT_PHONE="+91 9952293131"
